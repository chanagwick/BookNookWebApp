@model IEnumerable<BookNookWebApp.Models.Topics>

@{
    ViewData["Title"] = "Series";
}

<h1 class="display-4"><em>They Don't Stop Coming!</em></h1>

<div class="container mt-4 text-dark">
    <!-- Forum Header -->
    <div class="mb-4">
        <h2 class="fw-bold">Talk series with us</h2>
        <p class="lead">From trilogies to epic sagas, share your favorite book series and which installment truly stood out.</p>
    </div>

    <!-- New Topic Button -->
    <div class="mb-3">
        <a href="/Topics/Create" class="btn btn-dark">Start a New Topic</a>
    </div>

    <!-- List of Topics -->
    <div class="list-group">
        @if (Model.Any())
        {
            foreach (var topic in Model)
            {
                <a href="/Topics/Details/@topic.TopicId" class="list-group-item list-group-item-action border-dark mb-2 rounded shadow-sm">
                    <h5 class="mb-1">@topic.Title</h5>
                    @if (!string.IsNullOrWhiteSpace(topic.Description))
                    {
                        <p class="mb-1 text-muted">@topic.Description</p>
                    }
                </a>
            }
        }
        else
        {
            <div class="alert alert-info">
                No series topics yet. Start the series conversation!
            </div>
        }
    </div>
</div>
