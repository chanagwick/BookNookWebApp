@model IEnumerable<BookNookWebApp.Models.Topics>

@{
    ViewData["Title"] = "Dystopia";
}

<h1 class="display-4"><em>Welcome to the Dystopian Future!</em></h1>

<div class="container mt-4 text-dark">
    <!-- Forum Header -->
    <div class="mb-4">
        <h2 class="fw-bold">Discuss Dystopian Worlds</h2>
        <p class="lead">Dive into stories that paint a picture of a world gone wrong. What dystopian topics interest you most?</p>
    </div>

    <!-- New Topic Button -->
    <div class="mb-3">
        <a href="/Topics/Create" class="btn btn-dark">Start a New Topic</a>
    </div>

    <!-- List of Topics -->
    <div class="list-group">
        @if (Model.Any())
        {
            foreach (var topic in Model)
            {
                <!-- Modify link to route to Topics/Dystopia with TopicId -->
                <a href="@Url.Action("Dystopia", "Topics", new { id = topic.TopicId })" class="list-group-item list-group-item-action border-dark mb-2 rounded shadow-sm">
                    <h5 class="mb-1">@topic.Title</h5>
                    @if (!string.IsNullOrWhiteSpace(topic.Description))
                    {
                        <p class="mb-1 text-muted">@topic.Description</p>
                    }

                    <!-- Comment Section -->
                    <div class="mt-3">
                        <h6>Comments:</h6>
                        @if (topic.Comments != null && topic.Comments.Any())
                        {
                            <ul class="list-group">
                                @foreach (var comment in topic.Comments)
                                {
                                    <li class="list-group-item">
                                        <strong>@comment.User.UserName</strong>
                                        <span class="text-muted">@comment.PostedAt</span>
                                        <p>@comment.Content</p>

                                        <!-- Replies Section -->
                                        @if (comment.Replies.Any())
                                        {
                                            <ul class="list-group mt-3">
                                                @foreach (var reply in comment.Replies)
                                                {
                                                    <li class="list-group-item">
                                                        <strong>@reply.User.UserName</strong>
                                                        <span class="text-muted">@reply.PostedAt</span>
                                                        <p>@reply.Content</p>
                                                    </li>
                                                }
                                            </ul>
                                        }

                                        <!-- Reply Form -->
                                        <form asp-action="Create" asp-controller="Comments" method="post">
                                            <div class="form-group">
                                                <textarea name="Content" class="form-control" placeholder="Write a reply..." rows="3"></textarea>
                                            </div>
                                            <input type="hidden" name="TopicId" value="@topic.TopicId" />
                                            <input type="hidden" name="ParentCommentId" value="@comment.CommentId" />
                                            <input type="hidden" name="UserId" value="UserIdHere" /> <!-- Replace with actual UserId -->
                                            <button type="submit" class="btn btn-primary mt-2">Add Reply</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No comments yet. Be the first to comment!</p>
                        }

                        <!-- Add a new Comment Form -->
                        <form asp-action="Create" asp-controller="Comments" method="post">
                            <div class="form-group">
                                <textarea name="Content" class="form-control" placeholder="Write a comment..." rows="3"></textarea>
                            </div>
                            <input type="hidden" name="TopicId" value="@topic.TopicId" />
                            <input type="hidden" name="UserId" value="UserIdHere" /> <!-- Replace with actual UserId -->
                            <button type="submit" class="btn btn-primary mt-2">Add Comment</button>
                        </form>
                    </div>
                </a>
            }
        }
        else
        {
            <div class="alert alert-info">
                No dystopian topics yet. Start the conversation!
            </div>
        }
    </div>
</div>
