@{
    ViewData["Title"] = "Book Nook";
}

<div class="text-center" />
<h1 class="display-4">Book Nook</h1>
<hr />
<br />
<div class="container">
    <div class="row">
        <div class="col-md-6">
            <p class="display-1">Welcome to the Nook </p>
            <p class="lead">Find the one book you can't put down!</p>
            <a href="/Books/Index" class="btn btn-dark"> Browse</a>
        </div>
        <div class="col-md-6">
            <img src="~/css/open-book (1).png" class="img-fluid float-end" alt="An image">
        </div>
    </div>
</div>
<br />
<br />
<div class="text-center" />
<h1 class="display-4">Newest Arrivals</h1>
<hr />
<br />
<div class="container my-4">
    <div class="row justify-content-center">

        <div class="col-sm-12 col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
                <img src="~/css/Murder Book.jpg" class="card-img-top img-fluid" alt="The Cover of The Word is Murder by Anthony Horowitz">
                <div class="card-body">
                    <h5 class="card-title">The Word is Murder by Anthony Horowitz</h5>
                    <p class="card-text">The Word is Murder is a clever and gripping mystery by bestselling author Anthony Horowitz. When a wealthy woman is murdered just hours after planning her own funeral, a disgraced detective enlists Horowitz himself to document the case. Blending fiction and reality, this brilliantly original whodunit keeps readers guessing with sharp twists, witty dialogue, and a uniquely meta storytelling style.</p>
                    <a href="#" class="btn btn-dark">Discover</a>
                </div>
            </div>
        </div>

        <div class="col-sm-12 col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
                <img src="~/css/Percy Jackson.jpg" class="card-img-top img-fluid" alt="Newest Percy Jackson Book by Rick Riordan">
                <div class="card-body">
                    <h5 class="card-title">Percy Jackson and the Olympians: The Wrath of the Triple Goddess</h5>
                    <p class="card-text">Percy Jackson, a high school senior, must get three recommendation letters from Greek gods to attend New Rome University. After earning the first, he agrees to pet sit Hecate’s magical and difficult animals for the second. When Grover drinks a potion and causes chaos, the pets escape, and Percy, Annabeth, and Grover must find them and fix the damage before Hecate returns.</p>
                    <a href="#" class="btn btn-dark">Discover</a>
                </div>
            </div>
        </div>

        <div class="col-sm-12 col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
                <img src="~/css/Persepolis 2.jpg" class="card-img-top img-fluid" alt="Persepolis by Marjane Satrapi">
                <div class="card-body">
                    <h5 class="card-title">Persepolis by Marjane Satrapi</h5>
                    <p class="card-text">Persepolis is a critically acclaimed graphic novel by Marjane Satrapi that tells the powerful true story of her childhood in Iran during the Islamic Revolution. Through bold black-and-white illustrations, it offers a deeply personal look at life under political and religious oppression, blending history, humor, and humanity in a unique coming-of-age narrative.</p>
                    <a href="#" class="btn btn-dark">Discover</a>
                </div>
            </div>
        </div>

    </div>
</div>

<br />
<br />
<br />
<hr />
<div class="container">
    <div class="row">
        <div class="col-md-6">
            <p class="display-1">Our Forums</p>
            <p class="lead">Introduce yourself to our community <br />and find your new favorite read!</p>
            <a href="/Forums/Index" class="btn btn-dark mt-3">Join Now</a>
        </div>
        <br />
        <div class="col-md-6">
            <img src="~/css/diversity.png" class="img-fluid" alt="image of community">
        </div>
    </div>



