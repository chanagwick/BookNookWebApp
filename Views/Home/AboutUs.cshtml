@model IEnumerable<BookNookWebApp.Models.Books>

<h1 class="display-4"><em>About Us</em></h1>

<div class="container mt-4 text-dark">

    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold">Who We Are</h1>
        <p class="lead">Welcome to Book Nook — your cozy corner for books, community, and conversation.</p>
    </div>

    <!-- About Us Sections -->
    <div class="row row-cols-1 row-cols-md-2 g-4">

        <!-- Our Mission -->
        <div class="col">
            <div class="card border-dark h-100">
                <div class="card-body">
                    <h5 class="card-title">Our Mission</h5>
                    <p class="card-text">
                        At Book Nook, we strive to bring together readers from all walks of life to share stories, ideas, and inspiration.
                        Whether you're into fiction, non-fiction, or graphic novels — there's a place for you here.
                    </p>
                </div>
            </div>
        </div>

        <!-- Our Team -->
        <div class="col">
            <div class="card border-dark h-100">
                <div class="card-body">
                    <h5 class="card-title">Our Team</h5>
                    <p class="card-text">
                        We're a small group of developers, writers, and book lovers passionate about creating a vibrant online reading community.
                        Meet the minds behind the Nook!
                    </p>
                </div>
            </div>
        </div>

        <!-- Community Focus -->
        <div class="col">
            <div class="card border-dark h-100">
                <div class="card-body">
                    <h5 class="card-title">Community First</h5>
                    <p class="card-text">
                        We believe in respectful, enriching conversations and celebrating diverse perspectives. Book Nook is a safe and welcoming space for all.
                    </p>
                </div>
            </div>
        </div>

        <!-- Features -->
        <div class="col">
            <div class="card border-dark h-100">
                <div class="card-body">
                    <h5 class="card-title">Features & Tools</h5>
                    <p class="card-text">
                        Enjoy book reviews, forums, reading lists, and events tailored for every kind of reader. We're always working to improve your experience.
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>

