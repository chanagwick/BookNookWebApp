@model BookNookWebApp.Models.ForumPost

@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>
<p><em>Posted by @Model.User.UserName on @Model.PostedAt.ToString("MMM dd, yyyy")</em></p>
<p>@Model.Content</p>

<hr />

<!-- Display Comments -->
<h3>Comments</h3>
@if (Model.Comments.Any())
{
    foreach (var comment in Model.Comments)
    {
        <div class="comment">
            <p><strong>@comment.User.UserName</strong> on @comment.PostedAt.ToString("MMM dd, yyyy")</p>
            <p>@comment.Content</p>
        </div>
    }
}
else
{
    <p>No comments yet. Be the first to comment!</p>
}

<!-- Add New Comment -->
<h4>Add a Comment</h4>
<form asp-action="AddComment" method="post">
    <input type="hidden" name="ForumPostId" value="@Model.ForumPostId" />
    <div class="form-group">
        <label for="Content">Comment</label>
        <textarea id="Content" name="Content" class="form-control" rows="3" required></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
